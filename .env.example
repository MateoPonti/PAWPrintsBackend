# Copiar este archivo como .env y completar los valores. El .env no se sube al repo.
# En Render estas mismas variables se cargan en Environment (ahí no se usa el archivo .env).

# development muestra el detalle de los errores en la respuesta (campo "detalle"); production solo un mensaje genérico
APP_ENV=development
APP_DEBUG=true
APP_URL=http://localhost:8000

LOG_LEVEL=debug

# Dónde se publica el front: el navegador solo deja usar la API desde estos orígenes (CORS).
# Varios van separados por coma, sin barra final. Ejemplo en producción:
#   FRONT_URL=https://usuario.github.io
# Con APP_ENV=development también se acepta cualquier puerto de localhost / 127.0.0.1.
FRONT_URL=http://localhost:5500,http://127.0.0.1:5500

# Clave con la que se firman los tokens de ingreso (JWT). Obligatoria para el login: mínimo 32 caracteres.
# Generar una distinta para producción, por ejemplo con:  php -r "echo bin2hex(random_bytes(32));"
# Si se cambia, todas las sesiones abiertas dejan de valer.
JWT_SECRET=
# Segundos de validez del token (28800 = 8 horas)
JWT_TTL=28800

# Aviso de reservas por correo con la API HTTP de Brevo (https://www.brevo.com, plan gratuito: 300 correos/día).
# No se usa SMTP porque Render bloquea los puertos 25, 465 y 587 en el plan gratuito.
# MAIL_API_KEY: Brevo → SMTP & API → API Keys. Es secreta: va solo en el .env y en Render, nunca en el repo.
# Vacía = no se envía nada y el correo queda en logs/app.log (útil en desarrollo).
MAIL_API_KEY=
# MAIL_TO: quién recibe el aviso. MAIL_FROM: tiene que estar verificado en Brevo (Senders).
MAIL_TO=pawprints2026mercedesgrupokbmp@gmail.com
MAIL_FROM=pawprints2026mercedesgrupokbmp@gmail.com
MAIL_FROM_NAME=PawPrints

# Base de datos PostgreSQL (Neon): botón "Connect" de la consola, con "Connection pooling" DESACTIVADO.
# Con DB_HOST vacío la API funciona igual (catálogo desde data/libros.json),
# pero sin cuentas de usuario ni alta de libros.
DB_HOST=
DB_PORT=5432
DB_NAME=neondb
DB_USER=neondb_owner
DB_PASS=
# Con un Postgres local sin SSL: DB_SSLMODE=disable (por defecto es "require", que es lo que pide Neon)
# DB_SSLMODE=require
