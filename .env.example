# Copiar este archivo como .env y completar los valores. El .env no se sube al repo.

# development muestra el detalle de los errores; production muestra una página genérica
APP_ENV=development
APP_DEBUG=true
APP_URL=http://localhost:8000

LOG_LEVEL=debug

# Dirección del personal que recibe los avisos de reserva
MAIL_TO=reservas@pawprints.com.ar
MAIL_FROM=no-reply@pawprints.com.ar
MAIL_FROM_NAME=PawPrints

SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_SECURE=tls

# Base de datos PostgreSQL (Neon): botón "Connect" de la consola, con "Connection pooling" DESACTIVADO.
# Con DB_HOST vacío el sitio funciona igual que antes (catálogo desde data/libros.json),
# pero sin cuentas de usuario ni alta de libros.
DB_HOST=
DB_PORT=5432
DB_NAME=neondb
DB_USER=neondb_owner
DB_PASS=
# Con un Postgres local sin SSL: DB_SSLMODE=disable (por defecto es "require", que es lo que pide Neon)
# DB_SSLMODE=require
